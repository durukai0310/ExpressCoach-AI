# ============================================================
# ExpressCoach AI — API 配置文件
# ============================================================
#
# 使用方法:
#   1. 复制本文件为 .env:  copy .env.example .env
#   2. 填入你的 API Key
#   3. 保存文件
#
# ============================================================

# ============================================================
# ExpressCoach AI — API 配置文件模板
# ============================================================
#
# 使用方法:
#   1. 复制本文件为 .env:  copy .env.example .env   (或 cp .env.example .env)
#   2. 填入你的 API Key（去掉行首 # 取消注释）
#   3. .env 已在 .gitignore 中，不会被上传到 Git
#
# ============================================================

# DeepSeek API Key (主力引擎，必须配置)
# 免费注册获取: https://platform.deepseek.com/
# 新用户送 500 万 tokens!
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key填这里

# 千问 API Key (阿里云百炼，W4 竞品对比使用)
# 注册地址: https://dashscope.aliyun.com/
# 新用户有免费额度
# DASHSCOPE_API_KEY=sk-你的千问_API_Key填这里

# Kimi API Key (月之暗面 Moonshot，W4 竞品对比使用)
# 注册地址: https://platform.moonshot.cn/
# 新用户有免费额度
# MOONSHOT_API_KEY=sk-你的Kimi_API_Key填这里

# 默认模型 (可选: deepseek / qwen / kimi)
# MODEL=deepseek

# 禁用终端颜色 (可选, 用于日志重定向)
# NO_COLOR=1
