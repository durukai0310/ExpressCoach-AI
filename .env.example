# ============================================================

# ============================================================
# ExpressCoach AI — API 配置文件模板
# ============================================================
#
# 使用方法:
#   1. 复制本文件为 .env:  copy .env.example .env   (或 cp .env.example .env)
#   2. 填入你的 API Key（去掉行首 # 取消注释）
#   3. .env 已在 .gitignore 中，不会被上传到 Git
#
# ============================================================

# DeepSeek API Key (主力引擎，必须配置)
# 免费注册获取: https://platform.deepseek.com/
# 新用户送 500 万 tokens!
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key填这里

# 千问 API (阿里云 DashScope)
DASHSCOPE_API_KEY=your_dashscope_key_here

# Kimi API (月之暗面)
MOONSHOT_API_KEY=your_moonshot_key_here

# 默认模型 (可选: deepseek / qwen / kimi)
# MODEL=deepseek

# 禁用终端颜色 (可选, 用于日志重定向)
# NO_COLOR=1
